{
  "name": "@my-org/shared",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shared",
        "command": "tsc --project tsconfig.lib.json --noEmit"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shared",
        "command": "storybook dev --port 6006"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shared",
        "command": "test-storybook --url=http://localhost:6006"
      }
    }
  }
}